# Database (use the same user/password/db as docker-compose defaults, or your own Postgres)
POSTGRES_USER="discord_fantasy_bot"
POSTGRES_PASSWORD="dev_change_me"
POSTGRES_DB="discord_fantasy_bot"
POSTGRES_PORT="5432"

# Prisma: must match Postgres above if using docker-compose
DATABASE_URL="postgresql://discord_fantasy_bot:dev_change_me@localhost:5432/discord_fantasy_bot?schema=public"

DISCORD_TOKEN=""
DISCORD_CLIENT_ID=""
# Optional: also register commands to this guild for instant updates in that server.
# Global commands are still registered (required for DMs and to avoid “command outdated” in DM).
DISCORD_GUILD_ID=""
