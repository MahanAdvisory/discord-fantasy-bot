{
  "name": "discord-fantasy-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "postinstall": "prisma generate",
    "build": "tsc",
    "test": "node --test --import tsx \"src/**/*.test.ts\"",
    "audit:slash-desc": "node scripts/audit-slash-desc-lengths.mjs",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "sync:players": "tsx src/scripts/sleeper-sync.ts players",
    "sync:stats-week": "tsx src/scripts/sleeper-sync.ts stats-week",
    "sync:projections": "tsx src/scripts/sleeper-sync.ts projections",
    "sync:nflverse": "python etl/sync_nflverse.py",
    "sync:member-starts": "tsx src/scripts/snapshot-member-starts.ts",
    "yahoo:auth-url": "tsx scripts/spikes/yahoo-oauth-url.ts",
    "yahoo:exchange": "tsx scripts/spikes/yahoo-oauth-exchange.ts",
    "yahoo:smoke": "tsx scripts/spikes/yahoo-fantasy-smoke.ts",
    "yahoo:leagues": "tsx scripts/spikes/yahoo-leagues-smoke.ts",
    "cbs:smoke": "tsx scripts/spikes/cbs-fantasy-smoke.ts",
    "espn:smoke": "tsx scripts/spikes/espn-notification-smoke.ts",
    "espn:scan": "tsx scripts/spikes/espn-candidate-scan.ts",
    "web:dev": "npm run dev -w fantasy-web",
    "web:build": "npm run build -w fantasy-web",
    "web:start": "npm run start -w fantasy-web"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.2",
    "@prisma/client": "^6.19.0",
    "discord.js": "^14.25.1",
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "prisma": "^6.19.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
