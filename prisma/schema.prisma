generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Linked Discord account + optional Sleeper identity (provider-agnostic IDs in app code).
model User {
  id              String   @id @default(cuid())
  email           String?  @unique
  discordUserId   String?  @unique @map("discord_user_id")
  googleUserId    String?  @unique @map("google_user_id")
  sleeperUsername String?  @map("sleeper_username")
  sleeperUserId   String?  @map("sleeper_user_id")
  espnLeagueIds   Json?    @map("espn_league_ids")
  /// Map of ESPN league id (string) -> your ESPN fantasy team id (number) for roster/record resolution.
  espnTeamByLeague Json?   @map("espn_team_by_league")
  espnSeason      String?  @map("espn_season")
  espnS2          String?  @map("espn_s2")
  espnSwid        String?  @map("espn_swid")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  subscriptions       NotificationSubscription[]
  billingSubscription BillingSubscription?
  mentionMappings     SleeperMentionMapping[]

  @@map("users")
}

model SleeperMentionMapping {
  id String @id @default(cuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  guildId       String  @map("guild_id")
  sleeperUserId String  @map("sleeper_user_id")
  discordUserId String  @map("discord_user_id")
  note          String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([guildId, sleeperUserId])
  @@index([userId, guildId])
  @@map("sleeper_mention_mappings")
}

/// Stripe subscription state (one per app user). Webhook + Customer Portal keep this in sync.
model BillingSubscription {
  id                   String   @id @default(cuid())
  userId               String   @unique @map("user_id")
  stripeCustomerId     String   @unique @map("stripe_customer_id")
  stripeSubscriptionId String?  @unique @map("stripe_subscription_id")
  status               String
  currentPeriodEnd     DateTime? @map("current_period_end")
  cancelAtPeriodEnd    Boolean  @default(false) @map("cancel_at_period_end")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("billing_subscriptions")
}

/// Idempotent Stripe webhook processing (event ids from Stripe are unique).
model StripeEventLog {
  eventId    String   @id @map("event_id")
  receivedAt DateTime @default(now()) @map("received_at")

  @@map("stripe_event_log")
}

/// One row = one (league scope × category × destination) route.
model NotificationSubscription {
  id        String @id @default(cuid())
  userId    String @map("user_id")
  guildId   String? @map("guild_id")
  channelId String? @map("channel_id")
  isDm      Boolean @default(false) @map("is_dm")

  routeNamespace String @map("route_namespace")

  provider String @default("sleeper") @map("provider")
  sleeperLeagueScope String @map("sleeper_league_scope")
  sleeperDraftId     String? @map("sleeper_draft_id")

  category String @map("category")

  permissionNotifiedAt DateTime? @map("permission_notified_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([routeNamespace, sleeperLeagueScope, category])
  @@index([userId])
  @@index([guildId, channelId])
  @@index([sleeperLeagueScope])
  @@map("notification_subscriptions")
}

/// Full Sleeper NFL player record from GET /v1/players/nfl (keyed by player_id).
model SleeperPlayer {
  playerId  String   @id @map("player_id")
  data      Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("sleeper_players")
}

/// Per-player stats payloads from api.sleeper.com (season or weekly grouping).
model SleeperPlayerStats {
  id String @id @default(cuid())

  playerId   String @map("player_id")
  season     String
  seasonType String @map("season_type")
  /// "season" | "week" — matches Sleeper `grouping` query param.
  grouping String
  /// Week number when `grouping` is week-based; **-1** when storing season rollup rows (avoids UNIQUE NULL issues in Postgres).
  week Int @default(-1) @map("week")

  stats Json

  fetchedAt DateTime @default(now()) @map("fetched_at")

  @@unique([playerId, season, seasonType, grouping, week])
  @@index([playerId])
  @@index([season])
  @@map("sleeper_player_stats")
}

/// Bulk stats/projection-style JSON from list endpoints (whole season/week payloads for archival).
model SleeperStatsSnapshot {
  id String @id @default(cuid())

  /// e.g. stats_bulk_week, stats_bulk_season — helps identify source endpoint.
  kind       String
  season     String
  seasonType String @map("season_type")
  /// **-1** = whole-season / non-week bulk snapshot.
  week       Int          @default(-1)

  payload Json

  fetchedAt DateTime @default(now()) @map("fetched_at")

  @@unique([kind, season, seasonType, week])
  @@index([season])
  @@map("sleeper_stats_snapshots")
}

/// Simple key/value for sync cursors (e.g. last full player catalog sync).
model AppMeta {
  key   String @id
  value String

  @@map("app_meta")
}

/// Dedupe Sleeper transaction notifications per league NFL week (see GET .../transactions/:round).
model LeaguePollCursor {
  leagueId String @map("league_id")
  season   String
  week     Int

  /// Baseline: max `created` ms from Sleeper transactions processed for this poll cycle.
  lastTransactionCreatedMs BigInt @default(0) @map("last_transaction_created_ms")

  @@id([leagueId, season, week])
  @@map("league_poll_cursors")
}

/// Prevents double-posting when Sleeper bumps `created` on the same `transaction_id` (e.g. draft pick enrichment).
model LeagueTransactionNotified {
  leagueId       String   @map("league_id")
  transactionId  String   @map("transaction_id")
  notifiedAt     DateTime @default(now()) @map("notified_at")

  @@id([leagueId, transactionId])
  @@map("league_transaction_notified")
}

/// Dedupe draft picks / on-the-clock alerts per draft room.
model DraftPollCursor {
  draftId String @id @map("draft_id")

  /// Number of picks in the array last time we emitted draft_status updates.
  lastSeenPickCount Int @default(0) @map("last_seen_pick_count")

  /// Last `pick_no` we used for a draft_on_the_clock notification (Sleeper global pick number).
  lastOnClockPickNo Int @default(0) @map("last_on_clock_pick_no")

  /// Auction: last seen nominated player (baseline for nomination alerts).
  lastNominatedPlayerId String? @map("last_nominated_player_id")
  /// Auction: last seen high bid amount string from metadata.
  lastHighestOffer String? @map("last_highest_offer")
  /// Auction: last seen high bidder Sleeper user id.
  lastOfferingUserId String? @map("last_offering_user_id")
  /// Auction: `metadata.timer_end_at` we last sent a ~10-minute warning for.
  lastTimerWarnedEndAt String? @map("last_timer_warned_end_at")
  /// Auction: `metadata.last_action_at` baseline (skip replay on first poll).
  lastAuctionActionAt String? @map("last_auction_action_at")

  @@map("draft_poll_cursors")
}

/// Append-only audit of completed notification fan-outs (transactions, draft pick lines, on-the-clock DMs).
model NotificationEventJournal {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")

  eventKey String @unique @map("event_key")
  kind     String

  leagueId      String? @map("league_id")
  draftId       String? @map("draft_id")
  transactionId String? @map("transaction_id")
  season        String?
  week          Int?
  pickNo        Int?    @map("pick_no")

  targetCount Int @default(0) @map("target_count")
  meta        Json?

  @@index([leagueId])
  @@index([createdAt])
  @@map("notification_event_journal")
}

/// Maps Sleeper player_id ↔ nflverse / GSIS / ESPN ids for analytics joins.
model PlayerIdCrosswalk {
  sleeperPlayerId String  @id @map("sleeper_player_id")
  gsisId          String? @unique @map("gsis_id")
  espnId          String? @map("espn_id")
  pfrId           String? @map("pfr_id")
  fullName        String? @map("full_name")
  position        String?
  team            String?
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([gsisId])
  @@index([espnId])
  @@map("player_id_crosswalk")
}

/// Weekly (or season-rollup week=-1) nflverse player box + opportunity + usage stats.
model NflPlayerWeekStat {
  id String @id @default(cuid())

  /// Prefer GSIS id from nflverse; falls back to sleeper id when known.
  playerKey String @map("player_key")
  gsisId    String? @map("gsis_id")
  sleeperPlayerId String? @map("sleeper_player_id")

  season     Int
  week       Int
  /// "REG" | "POST" | "REG+POST" rollups use week=-1
  seasonType String @default("REG") @map("season_type")
  /// "week" | "season"
  grain      String @default("week")

  playerName String? @map("player_name")
  position   String?
  team       String?
  opponent   String?

  gamesPlayed Int @default(0) @map("games_played")

  // Passing
  completions   Int?
  attempts      Int?
  passingYards  Int? @map("passing_yards")
  passingTds    Int? @map("passing_tds")
  interceptions Int?
  passingAirYards Int? @map("passing_air_yards")
  passingYac    Int? @map("passing_yac")

  // Rushing
  carries      Int?
  rushingYards Int? @map("rushing_yards")
  rushingTds   Int? @map("rushing_tds")
  rushingFumblesLost Int? @map("rushing_fumbles_lost")
  rushingEpa   Float? @map("rushing_epa")

  // Receiving
  targets            Int?
  receptions         Int?
  receivingYards     Int? @map("receiving_yards")
  receivingTds       Int? @map("receiving_tds")
  receivingAirYards  Int? @map("receiving_air_yards")
  receivingYac       Int? @map("receiving_yac")
  receivingFumblesLost Int? @map("receiving_fumbles_lost")
  receivingEpa       Float? @map("receiving_epa")
  targetShare        Float? @map("target_share")
  airYardsShare      Float? @map("air_yards_share")
  wopr               Float?
  racr               Float?

  // nflverse precomputed (std / ppr reference)
  fantasyPoints    Float? @map("fantasy_points")
  fantasyPointsPpr Float? @map("fantasy_points_ppr")

  // ffopportunity expected components (Phase 2)
  receptionsExp      Float? @map("receptions_exp")
  receivingYardsExp  Float? @map("receiving_yards_exp")
  receivingTdsExp    Float? @map("receiving_tds_exp")
  rushingYardsExp    Float? @map("rushing_yards_exp")
  rushingTdsExp      Float? @map("rushing_tds_exp")
  passingYardsExp    Float? @map("passing_yards_exp")
  passingTdsExp      Float? @map("passing_tds_exp")
  totalFantasyPointsExp Float? @map("total_fantasy_points_exp")
  totalFantasyPointsDiff Float? @map("total_fantasy_points_diff")

  // Usage (Phase 3)
  offenseSnaps    Int? @map("offense_snaps")
  offenseSnapPct  Float? @map("offense_snap_pct")
  routesRun       Int? @map("routes_run")
  targetsPerRoute Float? @map("targets_per_route")

  // Roster % fallback (Phase 5)
  fantasyProsRosterPct Float? @map("fantasypros_roster_pct")

  raw Json?

  fetchedAt DateTime @default(now()) @map("fetched_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([playerKey, season, week, seasonType, grain])
  @@index([season, week, position])
  @@index([sleeperPlayerId])
  @@index([gsisId])
  @@map("nfl_player_week_stats")
}

/// Per-league weekly starter/rostered snapshot for member-universe start rate / VORP.
model SleeperPlayerWeekStart {
  id String @id @default(cuid())

  leagueId        String @map("league_id")
  season          String
  week            Int
  sleeperPlayerId String @map("sleeper_player_id")
  rosterId        Int    @map("roster_id")
  wasStarted      Boolean @map("was_started")
  wasRostered     Boolean @default(true) @map("was_rostered")
  position        String?

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([leagueId, season, week, sleeperPlayerId])
  @@index([season, week, sleeperPlayerId])
  @@index([leagueId, season, week])
  @@map("sleeper_player_week_starts")
}
