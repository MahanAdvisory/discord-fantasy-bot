# Shared DB
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/discord_fantasy_bot

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_with_random_secret

# Discord OAuth (from Discord Developer Portal -> OAuth2)
DISCORD_CLIENT_ID=your_discord_app_client_id
DISCORD_CLIENT_SECRET=your_discord_oauth_client_secret

# Public app origin (used for redirects and bot billing link fallback)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional Stripe (leave unset until monetization is enabled)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID=price_...
